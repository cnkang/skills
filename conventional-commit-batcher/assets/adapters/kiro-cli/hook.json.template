{
  "name": "Guard Git Commit",
  "version": "2.0.0",
  "description": "Check Git action scope without forcing unrelated commit batching.",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "shell"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "For a Git mutation, verify it matches the user's requested action and existing authorization. Staging does not authorize committing; committing does not authorize pushing. Preserve unrelated work. Use conventional-commit-batcher only when mixed changes need batching. Do not force a batching plan for staging-only or push-only commands, and do not ask again for an unchanged authorized scope."
  }
}
